NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
SESSION_SECRET=super-secret-key-at-least-32-chars-long-for-hmac
COOKIE_NAME=koyal_session
TIMEZONE=Asia/Kolkata
INITIAL_ADMIN_EMAIL=admin@koyalkinare.com
INITIAL_ADMIN_PASSWORD=Admin@KoyalKinare123

# Object Storage (Render Production Persistent Private S3/R2)
# Set to 's3' for production object storage; defaults to 'local' for local development
STORAGE_PROVIDER=local
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=koyal-kinare-invoices-private
S3_ACCESS_KEY_ID=placeholder-access-key-id
S3_SECRET_ACCESS_KEY=placeholder-secret-access-key
S3_FORCE_PATH_STYLE=false

